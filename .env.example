# Laptop AI Diagnosis System Environment Configuration

# Application
APP_NAME=AI-Based Laptop Problem Diagnosis System
APP_ENV=development
DEBUG=True
API_PREFIX=/api
PORT=8000
HOST=0.0.0.0

# Database (Defaults to local SQLite, PostgreSQL can be configured)
DATABASE_URL=sqlite:///./laptop_diagnosis.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/laptop_diagnosis

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# AI Configuration
AO_STAR_MAX_ITERATIONS=100
AO_STAR_COST_THRESHOLD=1000.0
